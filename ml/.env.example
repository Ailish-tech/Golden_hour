# ============================================================================
# SAMARITAN SHIELD — ML service configuration
# Copy to .env. ML_SERVICE_TOKEN must match the value in server/.env.
# ============================================================================

NODE_API_BASE=http://localhost:3000
ML_SERVICE_TOKEN=

# --- Capture ----------------------------------------------------------------
TARGET_FPS=12
INFER_EVERY_N=3

# --- YOLO -------------------------------------------------------------------
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35

# --- Stage 2 ----------------------------------------------------------------
# Absent by default. The service runs stage-1 only and reports stage2Score=null
# until you train one with train/train_cnn.py.
ENABLE_STAGE2=true
STAGE2_THRESHOLD=0.70

# --- Detector tuning --------------------------------------------------------
# Set these from the output of: python tools/calibrate.py data/videos/*.mp4
CANDIDATE_THRESHOLD=0.55
DEBOUNCE_WINDOW=6
DEBOUNCE_REQUIRED=4
