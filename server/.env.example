# ============================================================================
# SAMARITAN SHIELD — Server Configuration
# Copy to .env and fill in. The server refuses to start without auth config.
# ============================================================================

# --- Database ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/samaritan-shield

# --- HTTP -------------------------------------------------------------------
PORT=3000

# Comma-separated list of origins allowed to call the API.
# Empty means no browser origin is allowed (native clients are unaffected).
#
# In local development (ALLOW_INSECURE_NO_AUTH=true) any localhost port is
# accepted regardless of this list, because Expo moves to 8082, 8083 and onward
# whenever its preferred port is taken. Set this explicitly for any deployment.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Authentication ---------------------------------------------------------
# Firebase service-account credentials, as raw JSON or a path to the JSON file.
# Required: every endpoint except /api/health verifies a Firebase ID token.
FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above — path to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Local development ONLY, and never with real incident data. When set to true
# and no credentials are present, tokens are accepted without verification
# (bearer value is read as `uid:email`). Ignored when NODE_ENV=production.
# ALLOW_INSECURE_NO_AUTH=true

# Shared secret for the Python ML service. The server refuses to start without
# it. Must match ml/.env ML_SERVICE_TOKEN exactly.
ML_SERVICE_TOKEN=

# Routing for the green corridor. Set to `off` to force the straight-line
# fallback (tests do this). Leave the public OSRM URL for demos.
OSRM_BASE_URL=https://router.project-osrm.org
GREEN_CORRIDOR_SIGNAL_RADIUS_M=80

# Twilio trial: all three or none. DEMO_HOSPITAL_PHONE must be a number you
# verified on the trial account. Twilio cannot reach localhost — use ngrok
# (or similar) and set PUBLIC_BASE_URL to that https URL so TwiML loads.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# DEMO_HOSPITAL_PHONE=+91XXXXXXXXXX
# PUBLIC_BASE_URL=https://your-tunnel.example
