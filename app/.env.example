# ============================================================================
# SAMARITAN SHIELD — App Configuration
# Copy to .env. Expo exposes EXPO_PUBLIC_* variables to the client bundle,
# so nothing secret belongs here.
# ============================================================================

# Backend base URL. A phone cannot reach the bundler host's localhost, so for
# device testing set this to your machine's LAN address (e.g. http://192.168.1.9:3000)
# or a deployed backend.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase web config. These are public project identifiers, not secrets —
# access is governed by Firebase Auth and your security rules. Override them
# to point at your own Firebase project.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
